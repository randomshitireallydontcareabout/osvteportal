{
  "component": {
    "name": "Micron DDR4 DIMM",
    "description": "Step-by-step Micron DDR4 inspection, testing, logging, and closeout guide.",
    "category": "MEMORY",
    "entrypoint": "presentation.wi",
    "revision": "WI-007 Rev C01",
    "order": 10
  },
  "steps": [
    {
      "title": "Verify PPE and tester readiness",
      "subtitle": "Prepare the work area before handling any DIMM.",
      "type": "SAFETY",
      "items": [
        {
          "text": "Wear required PPE, including gloves and an ESD wrist strap.",
          "images": [
            "data:image/jpeg;base64,"
          ]
        },
        {
          "text": "Confirm the tester is powered OFF before installing DIMMs.",
          "images": []
        },
        {
          "text": "Verify the USB is connected to the back of the tester before power-on.",
          "images": []
        },
        {
          "text": "Keep the DIMM inside its ESD bag until inspection begins.",
          "images": []
        }
      ],
      "warning": "The USB contains the tester boot and test instructions. If it is not connected before power-on, it may not mount and the tester may not boot."
    },
    {
      "title": "Confirm the DIMM is Micron DDR4",
      "subtitle": "Prevent the wrong DIMM brand from entering this tester.",
      "type": "STOP CHECK",
      "items": [
        "Read the manufacturer label and confirm the brand is MICRON.",
        "Confirm the component is DDR4 and matches a supported stock code.",
        "Do not use this tester or slot mapping for Hynix DIMMs.",
        "If the brand or part identity is uncertain, stop and ask OSV leadership."
      ],
      "warning": "MICRON ONLY. Do not test Hynix DDR4 DIMMs in the Micron DDR4 workflow."
    },
    {
      "title": "Perform the pre-test physical inspection",
      "subtitle": "Inspect the component before applying power.",
      "type": "INSPECTION",
      "items": [
        "Remove the DIMM from the ESD bag using proper ESD handling.",
        "Inspect the gold fingers, capacitors, PCB, and connector edges.",
        "Use a microscope to check for cracks, missing parts, burns, contamination, or bent areas.",
        "If damage is found, mark the location with a yellow arrow sticker and return the DIMM to the ZTP team."
      ],
      "warning": "Do not continue testing a physically damaged DIMM.",
      "image": "inspection_reference.jpeg"
    },
    {
      "title": "Validate MRS ticket and serial number",
      "subtitle": "Make sure the correct component is recorded in the OSV Portal.",
      "type": "PORTAL",
      "items": [
        "Scan the Micron DDR4 DIMM MRS ticket.",
        "Scan the DIMM serial number and verify it matches the physical label.",
        "Check the OSV Portal for a previous test record.",
        "If previously tested, notify the ZTP team and do not test again.",
        "If not previously tested, complete the OSV Portal entry and continue."
      ],
      "warning": "Never continue with a mismatched serial number or a duplicate test record."
    },
    {
      "title": "Load DIMMs in the correct slot sequence",
      "subtitle": "Correct slot order keeps node, slot, and result data aligned.",
      "type": "LOADING",
      "items": [
        {
          "text": "Start with Node 0 and load: A1, B1, C1, D1, E1, F1.",
          "image": "power_on.png"
        },
        "Complete Node 0 before loading Node 1.",
        {
          "text": "Load Node 1 in the same order: A1, B1, C1, D1, E1, F1.",
          "image": "node1_loading.png"
        },
        "Do not use A2 or D2 on either node.",
        "Confirm every DIMM is oriented correctly, fully seated, and locked."
      ],
      "warning": "Do not skip slots or load out of order unless an approved test procedure specifically instructs you to do so.",
      "image": "tester_layout.png"
    },
    {
      "title": "Power on and wait for POST",
      "subtitle": "Allow the tester to complete its startup sequence.",
      "type": "POWER ON",
      "items": [
        "Reconfirm the USB is connected and all DIMMs are fully seated.",
        "Press the power button at the left-hand corner of the tester.",
        "Listen for the system boot approximately one minute after power-on.",
        "Allow approximately three minutes for the system to POST.",
        "If a DIMM is not detected, power off, remove it, inspect it under a microscope, and follow approved electrical-damage checks."
      ],
      "warning": "Never install, remove, or reseat a DIMM while the tester is powered on.",
      "image": "power_on.png"
    },
    {
      "title": "Configure MemTest86",
      "subtitle": "Use the approved DDR4 test selection and pass count.",
      "type": "TEST SETUP",
      "items": [
        "At the MemTest86 v11.7 main screen, press T for Test Selection.",
        "Select approved tests 1 through 7.",
        "Do not select tests 8, 9, or 10 for this work instruction.",
        "Set the Pass Count to 2.",
        "Review the selection before starting."
      ],
      "warning": "Approved selection: tests 1-7 only, with 2 passes.",
      "image": "memtest_menu.png"
    },
    {
      "title": "Run and monitor the test",
      "subtitle": "Start the test and watch for detection or test failures.",
      "type": "TESTING",
      "items": [
        "Press S to start the test.",
        "Monitor the screen for the overall result and DIMM-level failures.",
        "Do not interrupt power unless an approved safety response requires it.",
        "When testing finishes, identify every passed and failed DIMM before continuing."
      ],
      "warning": "A system-level pass can still contain a failed DIMM. Review the DIMM result details.",
      "image": "pass_screen.png",
      "image2": "fail_screen.png"
    },
    {
      "title": "Generate and save the test logs",
      "subtitle": "Write the completed test record to the connected USB.",
      "type": "LOGS",
      "items": [
        "When testing is complete, press ENTER.",
        "At the save prompt, press Y to generate and save the logs to the USB.",
        "Wait for the save process to finish before removing the USB.",
        "Confirm the log file exists before shutting down or moving to closeout."
      ],
      "warning": "Do not remove the USB while logs are being written.",
      "image": "save_logs.png"
    },
    {
      "title": "Copy logs to the Micron shared folder",
      "subtitle": "Store logs in the correct DDR4 year and month location.",
      "type": "FILE STORAGE",
      "items": [
        "Open the Micron shared log folder.",
        "Select the DDR4 folder.",
        "Select the correct test year.",
        "Select the correct test month.",
        "Copy the logs and verify the files appear in the destination."
      ],
      "warning": "Wrong product, year, or month folders can make test evidence difficult to locate.",
      "action": "OPEN MICRON LOG FOLDER"
    },
    {
      "title": "Complete post-test inspection and records",
      "subtitle": "Close the physical and electronic test record.",
      "type": "CLOSEOUT",
      "items": [
        "Power off the tester before removing DIMMs.",
        "Perform a post-test physical inspection for any new damage.",
        "If damage is found, notify OSV leadership, update the OSV Portal, and create a physical-damage ticket.",
        "Record an accurate result. For failures, include the actual failure reason, not only the word Failed.",
        "Place the ticket in the traveler sleeve and return each Micron DIMM to its correct ESD bag and cart.",
        "Complete the required MES Test Lab Records screenshot, export/filter process, and check-in/out chat submission.",
        "Use the Log Analyzer when needed to identify failed DIMMs and marginal passing DIMMs."
      ],
      "warning": "Verify the DIMM identity and ESD bag match before returning material for pickup.",
      "image": "log_analyzer.png"
    }
  ]
}